# Fork of the sm6225-mainline kernel package with the xun board additions.
# The xun-files.tar.gz and firmware.tar.gz sources are produced by
# scripts/sync-pmaports.sh from the bring-up tree; run `abuild checksum` after
# syncing.
maintainer="xun port <xun@localhost>"
pkgname=linux-postmarketos-qcom-sm6225
pkgver=7.2.1
pkgrel=1
pkgdesc="Mainline kernel fork for SM6225 devices (xun)"
arch="aarch64"
_carch="arm64"
_flavor="postmarketos-qcom-sm6225"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bison
	clang
	diffutils
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	zstd
"

_repository="linux-v.7.2.1"
_commit="f5a976a8334c7563137352eaafe8d49a2a3b8c6a"
source="
	$pkgname-$_commit.tar.gz::https://gitlab.postmarketos.org/sm6225-mainline/kernels/$_repository/-/archive/$_commit.tar.gz
	xun-files.tar.gz
	firmware.tar.gz
"
builddir="$srcdir/$_repository-$_commit"

prepare() {
	default_prepare
	tar -xzf "$srcdir/xun-files.tar.gz" -C "$srcdir"
	tar -xzf "$srcdir/firmware.tar.gz" -C "$srcdir"
	sh "$srcdir/xun/prepare-kernel.sh" "$builddir" "$srcdir/xun" "$srcdir"
}

build() {
	unset LDFLAGS
	make -C "$builddir" ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-$_flavor" all Image.gz
}

package() {
	mkdir -p "$pkgdir"/boot

	make -C "$builddir" modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir/boot/dtbs-tmp"

	install -Dm644 "$builddir/arch/arm64/boot/Image.gz" "$pkgdir/boot/vmlinuz"
	# The xun v4 shim packs the uncompressed Image.
	install -Dm644 "$builddir/arch/arm64/boot/Image" "$pkgdir/boot/Image"

	mkdir -p "$pkgdir"/boot/dtbs/qcom
	cp -r "$pkgdir"/boot/dtbs-tmp/qcom/sm6225* "$pkgdir"/boot/dtbs/qcom/
	rm -r "$pkgdir"/boot/dtbs-tmp

	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -Dm644 "$builddir/include/config/kernel.release" \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"
}

sha512sums="
