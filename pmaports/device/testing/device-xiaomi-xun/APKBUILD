# Reference: <https://postmarketos.org/devicepkg>
maintainer="xun port <xun@localhost>"
pkgname=device-xiaomi-xun
pkgver=1
pkgrel=0
pkgdesc="Xiaomi Redmi Pad SE 11 (xun)"
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
replaces="gdm bluez"
depends="
	alsa-ucm-conf
	alsa-utils
	bluez
	chrony
	curl
	dconf
	dnsmasq
	firmware-xiaomi-xun
	gdm
	linux-postmarketos-qcom-sm6225
	make-dynpart-mappings
	mesa-vulkan-freedreno
	networkmanager
	postmarketos-base
	pulseaudio
	qbootctl
	rmtfs
	swclock-offset
	tqftpserv
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
"

build() {
	devicepkg_build "$startdir" "$pkgname"
}

package() {
	devicepkg_package "$startdir" "$pkgname"

	# Board files: local.d services, GDM/dconf/NetworkManager/Bluetooth
	# configuration, session wrappers, the elogind sleep hook and the ALSA
	# UCM profile.
	cp -a "$startdir"/files/. "$pkgdir"/
	for _d in etc/local.d usr/local/bin usr/libexec; do
		[ -d "$pkgdir/$_d" ] &&
			find "$pkgdir/$_d" -type f -exec chmod 755 {} +
	done
}

