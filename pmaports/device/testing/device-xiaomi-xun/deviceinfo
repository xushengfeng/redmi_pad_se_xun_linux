deviceinfo_format_version="0"
deviceinfo_name="Xiaomi Redmi Pad SE 11"
deviceinfo_manufacturer="Xiaomi"
deviceinfo_codename="xiaomi-xun"
deviceinfo_year="2023"
deviceinfo_dtb="qcom/sm6225-xiaomi-xun"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_chassis="tablet"
deviceinfo_external_storage="true"

# Bootloader related.
# xun boots through the tapas v4 shim: ABL supplies its own DTB/vendor
# ramdisk, so the boot image is assembled by build/build-xun.sh and written
# to the inactive slot instead of being generated by boot-deploy.
deviceinfo_flash_method="fastboot"
deviceinfo_generate_bootimg="false"
deviceinfo_flash_pagesize="4096"
deviceinfo_rootfs_image_sector_size="4096"
deviceinfo_super_partitions="/dev/disk/by-partlabel/super"
deviceinfo_usb_idVendor="0x1d6b"
deviceinfo_usb_idProduct="0x0104"

deviceinfo_drm="true"
