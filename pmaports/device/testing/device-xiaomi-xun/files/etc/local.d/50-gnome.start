#!/bin/sh
# The default runlevel does not pick these up on this rootfs, so start them
# explicitly. GDM needs the session bus and logind before it can log xun in.
#
# gnome-shell only creates its screen shield (the lock button, Super+L and the
# idle lock) when GDM answers on the system bus and logind's seat directory
# exists; elogind does not create that directory itself.
/etc/init.d/dbus start
/etc/init.d/elogind start
/etc/init.d/polkit start
mkdir -p /run/systemd/seats
/etc/init.d/gdm start
rc-service chronyd start 2>/dev/null
rc-service bluetooth start 2>/dev/null
