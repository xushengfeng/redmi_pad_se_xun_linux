+/*
+ * The BQ2589X lets a Quick Charge adapter settle at 9 V (see the HVDCP
+ * setup in bq25890_hw_init()), but the chip's own D+/D- detection sets a
+ * 1.5 A input limit for a MaxCharge source.  Raise it to 2 A so the charger
+ * can pull the full 18 W from a 9 V adapter while the cell takes 3.6 A.
+ * Standard USB sources keep their BC1.2 limits.
+ */
+#define BQ2589X_FAST_CHARGE_IINLIM_UA	2000000
+
+static void bq25890_bq2589x_update_iinlim(struct bq25890_device *bq)
+{
+	u32 iinlim_ua;
+	u8 lval;
+
+	if (!bq->is_bq2589x || !bq->state.online)
+		return;
+
+	switch (bq->state.vbus_type) {
+	case BQ25890_VBUS_SDP:
+		iinlim_ua = 500000;
+		break;
+	case BQ25890_VBUS_CDP:
+		iinlim_ua = 1500000;
+		break;
+	case BQ25890_VBUS_DCP:
+	case BQ25890_VBUS_HVDCP:
+		iinlim_ua = BQ2589X_FAST_CHARGE_IINLIM_UA;
+		break;
+	default:
+		return;
+	}
+
+	lval = bq25890_find_idx(iinlim_ua, TBL_IINLIM);
+	bq25890_field_write(bq, F_IINLIM, lval);
+}
