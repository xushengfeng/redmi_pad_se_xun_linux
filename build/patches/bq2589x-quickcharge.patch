+
 	/*
 	 * Restore HiZ bit in case it was set by user. The chip does not retain
 	 * this bit on cable replug, hence the bit must be reset manually here.
@@ -899,6 +939,8 @@
 	}
 
 	bq->state = new_state;
+	if (vbus_changed)
+		bq25890_bq2589x_update_iinlim(bq);
 	power_supply_changed(bq->charger);
 
 	return IRQ_HANDLED;
@@ -1015,6 +1057,26 @@
 		return ret;
 	}
 
+	/*
+	 * The BQ2589X advertises the Quick Charge handshake only when asked
+	 * to; keep MAXC_EN clear so an adapter settles at 9 V rather than
+	 * 12 V.  The charger then runs its own D+/D- negotiation whenever a
+	 * cable is attached (AUTO_DPDM_EN below).
+	 */
+	if (bq->is_bq2589x) {
+		ret = bq25890_field_write(bq, F_HVDCP_EN, 1);
+		if (ret < 0) {
+			dev_dbg(bq->dev, "Enabling HVDCP failed %d\n", ret);
+			return ret;
+		}
+
+		ret = bq25890_field_write(bq, F_MAXC_EN, 0);
+		if (ret < 0) {
+			dev_dbg(bq->dev, "Selecting 9 V HVDCP failed %d\n", ret);
+			return ret;
+		}
+	}
+
 	/* Run D+/D- detection in hardware when requested (e.g. Xiaomi
 	 * spes boards set ti,enable-auto-dpdm); the result lands in
 	 * VBUS_STAT and is reported via POWER_SUPPLY_PROP_USB_TYPE. */
@@ -1037,6 +1099,8 @@
 		return ret;
 	}
 
