+/* Ask the chip to run D+/D- detection now and wait for it to finish. */
+static int bq25890_force_dpdm(struct bq25890_device *bq)
+{
+	int ret, val;
+
+	ret = bq25890_field_write(bq, F_FORCE_DPM, 1);
+	if (ret < 0)
+		return ret;
+
+	return regmap_field_read_poll_timeout(bq->rmap_fields[F_FORCE_DPM],
+					      val, !val, 20000, 500000);
+}
