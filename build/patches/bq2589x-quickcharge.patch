+static void bq25890_dpdm_work(struct work_struct *work)
+{
+	struct bq25890_device *bq =
+		container_of(work, struct bq25890_device, dpdm_work.work);
+	struct bq25890_state new_state;
+	int ret;
+
+	mutex_lock(&bq->lock);
+	if (!bq->state.online)
+		goto out;
+
+	bq->dpdm_retries++;
+	dev_info(bq->dev, "re-running D+/D- detection (%u)\n",
+		 bq->dpdm_retries);
+	ret = bq25890_force_dpdm(bq);
+	if (ret < 0)
+		dev_warn(bq->dev, "Forced DPDM failed %d\n", ret);
+
+	ret = bq25890_get_chip_state(bq, &new_state);
+	if (ret < 0)
+		goto out;
+
+	bq->state = new_state;
+	bq25890_bq2589x_update_iinlim(bq);
+	power_supply_changed(bq->charger);
+
+	if (bq->state.online && bq->state.vbus_type == BQ25890_VBUS_UNKNOWN &&
+	    bq->dpdm_retries < 2)
+		schedule_delayed_work(&bq->dpdm_work, msecs_to_jiffies(300));
+out:
+	mutex_unlock(&bq->lock);
+}
