--- a2/drivers/power/reset/msm-poweroff.c	2026-11-01 02:32:41.278408376 +0800
+++ b2/drivers/power/reset/msm-poweroff.c	2026-11-01 02:36:07.082105165 +0800
@@ -2,6 +2,7 @@
