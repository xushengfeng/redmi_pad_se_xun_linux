+	/* With in-band sleep off there is no sleep to negotiate with the
+	 * controller; waiting for QCA_IBS_DISABLED to clear would just time
+	 * out and abort the system suspend.
+	 */
+	if (test_bit(QCA_IBS_DISABLED, &qca->flags) &&
+	    !test_bit(QCA_SSR_TRIGGERED, &qca->flags))
+		return 0;
+
 	if (test_bit(QCA_IBS_DISABLED, &qca->flags) ||
