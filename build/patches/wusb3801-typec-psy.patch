+/*
+ * Publish the current a USB-C source advertises on CC.  The charger looks
+ * this up when the D+/D- lines do not identify a BC1.2/Quick Charge source,
+ * so a PD-only supply can still be used at 5 V/3 A instead of the 500 mA
+ * "unknown source" default.
+ */
+static int wusb3801_get_iinlim(struct wusb3801 *wusb3801, int *iinlim)
+{
+	unsigned int status;
+	int ret;
+
+	ret = regmap_read(wusb3801->regmap, WUSB3801_REG_STAT, &status);
+	if (ret)
+		return ret;
+
+	if (!(status & WUSB3801_STAT_VBUS_DETECTED)) {
+		*iinlim = 0;
+		return 0;
+	}
+
+	switch (status & WUSB3801_STAT_CURRENT) {
+	case WUSB3801_STAT_CURRENT_1_5A:
+		*iinlim = 1500000;
+		break;
+	case WUSB3801_STAT_CURRENT_3_0A:
+		*iinlim = 3000000;
+		break;
+	default:
+		*iinlim = 500000;
+		break;
+	}
+
+	return 0;
+}
+
+static enum power_supply_property wusb3801_psy_props[] = {
+	POWER_SUPPLY_PROP_ONLINE,
+	POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT,
+};
+
+static int wusb3801_psy_get_property(struct power_supply *psy,
+				     enum power_supply_property psp,
+				     union power_supply_propval *val)
+{
+	struct wusb3801 *wusb3801 = power_supply_get_drvdata(psy);
+	unsigned int status;
+	int ret;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_ONLINE:
+		ret = regmap_read(wusb3801->regmap, WUSB3801_REG_STAT,
+				  &status);
+		if (ret)
+			return ret;
+		val->intval = !!(status & WUSB3801_STAT_VBUS_DETECTED);
+		break;
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		ret = wusb3801_get_iinlim(wusb3801, &val->intval);
+		if (ret)
+			return ret;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
