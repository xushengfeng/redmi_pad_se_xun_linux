 #define PON_SOFT_RB_SPARE		0x8f
 
+#define PON_PS_HOLD_RST_CTL		0x5a
+#define PON_PS_HOLD_RST_CTL2		0x5b
+#define PON_RESET_EN			BIT(7)
+#define PON_POWER_OFF_MASK		GENMASK(3, 0)
+#define PON_POWER_OFF_SHUTDOWN		0x4
+
+#define PON_TRIGGER_EN			0x80
+#define PON_SMPL_CTL			0x7f
+#define PON_REASON1			0xc0
+#define PON_WARM_RESET_REASON1		0xc2
+#define PON_POFF_REASON1		0xc5
+#define PON_OFF_REASON			0xc7
+
+/* PON trigger sources: SMPL, RTC, DC_CHG, USB_CHG, PON1, CBLPWR */
+#define PON_TRIG_CHARGER		(BIT(3) | BIT(4) | BIT(6))
+
+
 #define GEN1_REASON_SHIFT		2
 #define GEN2_REASON_SHIFT		1
 
