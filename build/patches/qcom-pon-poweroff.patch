+/*
+ * The PMIC resets the SoC when PS_HOLD goes low, which turns a shutdown back
+ * into a reboot. Tell the PON to power down instead before the reset (PSCI
+ * SYSTEM_OFF or the PS_HOLD release) happens.
+ */
+static void qcom_pon_disable_charger_boot(struct qcom_pon *pon)
+{
+	/*
+	 * With a charger connected the PMIC powers the SoC again right after
+	 * the shutdown; keep the power key as the only way back on.
+	 */
+	regmap_update_bits(pon->regmap, pon->baseaddr + PON_TRIGGER_EN,
+			   PON_TRIG_CHARGER, 0);
+}
+
+static int qcom_pon_power_off_prepare(struct sys_off_data *data)
+{
+	struct qcom_pon *pon = data->cb_data;
+	int ret;
+
+	if (pon->reason_shift != GEN2_REASON_SHIFT)
+		return NOTIFY_DONE;
+
+	ret = regmap_update_bits(pon->regmap,
+				 pon->baseaddr + PON_PS_HOLD_RST_CTL2,
+				 PON_RESET_EN, 0);
+	if (ret)
+		goto err;
+
+	usleep_range(500, 1000);
+
+	ret = regmap_update_bits(pon->regmap,
+				 pon->baseaddr + PON_PS_HOLD_RST_CTL,
+				 PON_POWER_OFF_MASK, PON_POWER_OFF_SHUTDOWN);
+	if (ret)
+		goto err;
+
+	ret = regmap_update_bits(pon->regmap,
+				 pon->baseaddr + PON_PS_HOLD_RST_CTL2,
+				 PON_RESET_EN, PON_RESET_EN);
+	if (ret)
+		goto err;
+
+	qcom_pon_disable_charger_boot(pon);
+
+	dev_info(pon->dev, "PS_HOLD power off type = shutdown\n");
+	return NOTIFY_DONE;
+
+err:
+	dev_err(pon->dev, "failed to configure PS_HOLD power off: %d\n", ret);
+	return NOTIFY_DONE;
+}
+
+
+static ssize_t ps_hold_rst_ctl_show(struct device *dev,
+				    struct device_attribute *attr, char *buf)
+{
+	struct qcom_pon *pon = dev_get_drvdata(dev);
+	unsigned int ctl = 0, ctl2 = 0;
+
+	regmap_read(pon->regmap, pon->baseaddr + PON_PS_HOLD_RST_CTL, &ctl);
+	regmap_read(pon->regmap, pon->baseaddr + PON_PS_HOLD_RST_CTL2, &ctl2);
+	return sysfs_emit(buf, "0x%02x 0x%02x\n", ctl, ctl2);
+}
+static DEVICE_ATTR_RO(ps_hold_rst_ctl);
+
+static ssize_t poweroff_prepare_store(struct device *dev,
+				      struct device_attribute *attr,
+				      const char *buf, size_t count)
+{
+	struct qcom_pon *pon = dev_get_drvdata(dev);
+	struct sys_off_data data = {
+		.dev = dev,
+		.cb_data = pon,
+	};
+
+	qcom_pon_power_off_prepare(&data);
+	return count;
+}
+static DEVICE_ATTR_WO(poweroff_prepare);
+
+static ssize_t pon_regs_show(struct device *dev,
+			     struct device_attribute *attr, char *buf)
+{
+	struct qcom_pon *pon = dev_get_drvdata(dev);
+	static const u8 regs[] = {
+		PON_PS_HOLD_RST_CTL, PON_PS_HOLD_RST_CTL2, PON_TRIGGER_EN,
+		PON_SMPL_CTL, PON_REASON1, PON_WARM_RESET_REASON1,
+		PON_POFF_REASON1, PON_OFF_REASON,
+	};
+	ssize_t len = 0;
+	unsigned int val;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(regs); i++) {
+		if (regmap_read(pon->regmap, pon->baseaddr + regs[i], &val))
+			return -EIO;
+		len += sysfs_emit_at(buf, len, "%02x=%02x ", regs[i], val);
+	}
+
+	len += sysfs_emit_at(buf, len, "\n");
+	return len;
+}
+static DEVICE_ATTR_RO(pon_regs);
+
