# xun (Redmi Pad SE) on top of the sm6225-mainline base config

CONFIG_LOCALVERSION="-xun"
# CONFIG_LOCALVERSION_AUTO is not set

# The shim passes our DTB, so this is the command line.
CONFIG_CMDLINE="console=tty0 consoleblank=0 loglevel=7 printk.devkmsg=on log_buf_len=2M clk_ignore_unused pd_ignore_unused fw_devlink=off deferred_probe_timeout=120 rcupdate.rcu_cpu_stall_suppress=1"
CONFIG_CMDLINE_FROM_BOOTLOADER=y

# Kernel log over a warm reset, reboot and power off through the PMIC
CONFIG_PSTORE_RAM=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_POWER_RESET_MSM=y

CONFIG_DEBUG_INFO_NONE=y

# eMMC, SD card and the Android/F2FS partitions
CONFIG_MMC_SDHCI_MSM=y
CONFIG_F2FS_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_UTF8=y

# M84 panels
CONFIG_DRM_PANEL_XIAOMI_M84_35_03_0B=y
CONFIG_DRM_PANEL_XIAOMI_M84_36_02_0A=y
CONFIG_DRM_PANEL_XIAOMI_M84_42_03_0C=y

# Touch: FocalTech over SPI
CONFIG_SPI=y
CONFIG_TOUCHSCREEN_FTS=y

# Wi-Fi/BT
CONFIG_ATH10K=y
CONFIG_BT_HCIUART=y

# USB gadget for the bring-up shell
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_GADGET=y

CONFIG_FW_LOADER_COMPRESS=y

# Firmware needed before the rootfs is up (the GPU probes from the initramfs)
CONFIG_EXTRA_FIRMWARE="qcom/a630_sqe.fw qcom/a610_zap.mdt qcom/a610_zap.b00 qcom/a610_zap.b01 qcom/a610_zap.b02 focaltech_ts_fw_huaxing_ft8203.bin focaltech_ts_fw_boe_ft8203.bin qca/crbtfw13.tlv qca/crnv13.bin"
CONFIG_EXTRA_FIRMWARE_DIR="@BUILD_DIR@/firmware"

# Touch: FT8203 on SPI
CONFIG_TOUCHSCREEN_FT8203=y

# PMIC RTC: keeps the clock across reboots (NTP syncs it once Wi-Fi is up)
CONFIG_RTC_DRV_PM8XXX=y

# Battery fuel gauge
CONFIG_SH366101=y

# Android vendor/odm logical partitions (erofs) for firmware extraction
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y

# FS1815 speaker amplifiers (four, two I2C buses)
CONFIG_SND_SOC_FS1815=y

# Shared GPIO lines (the two speaker amplifiers of a bus share a reset)
CONFIG_GPIO_SHARED_PROXY=y

# Cameras: GC08A3 rear, HI556 front (plus the other module variants)
CONFIG_VIDEO_GC08A3=y
CONFIG_VIDEO_GC05A2=y
CONFIG_VIDEO_OV08D10=y
CONFIG_VIDEO_HI556=y
